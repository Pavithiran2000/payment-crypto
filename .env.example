# --- database ---
# Local Postgres install (not the docker-compose container).
# postgresql://<user>:<password>@<host>:<port>/payment_platform
DATABASE_URL=postgresql://postgres:pavi1234@localhost:5433/payment_platform
DB_POOL_MAX=10
DB_SSL=false

# --- PII key material ---
# Local dev only. In production these MUST come from a KMS / secret manager,
# never from env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_MASTER_KEK=
# Must survive subject erasure, so it is a separate secret from the KEK.
PII_BLIND_INDEX_PEPPER=

# --- MoonPay fiat-to-crypto on-ramp ---
# Three DIFFERENT keys, all from https://dashboard.moonpay.com -> Developers.
# All three must be from the same environment: the API refuses to boot on a
# mix of pk_live_ and wk_test_, because that combination takes real money and
# then silently rejects every event telling you what happened.
#
# Publishable key. Goes in the widget URL and in API query strings. Public by
# design - it is visible to anyone who opens the payment page.
MOONPAY_PUBLISHABLE_KEY=
# Secret key. Signs widget URLs and hashes the payer IP. NEVER sent to MoonPay,
# never in a URL, never in the browser bundle. Treat it like a signing key,
# because that is all it is.
MOONPAY_SECRET_KEY=
# Webhook key. Verifies inbound webhook signatures. A DIFFERENT secret from
# MOONPAY_SECRET_KEY - using the secret key here fails every signature check
# with no visible error other than 400s in MoonPay's webhook log.
MOONPAY_WEBHOOK_KEY=

# 'embedded' frames MoonPay on our own page (default, recommended): the
# customer never leaves our domain. Apple Pay and Google Pay do not work in an
# iframe, so 'redirect' navigates to MoonPay instead and returns via
# redirectURL. Both flows produce identical webhooks and identical records.
MOONPAY_WIDGET_MODE=embedded

# Binds every widget URL to a hash of the payer's IP, so a signed URL lifted
# into another browser will not load. MoonPay requires this to go live, so it
# is FORCED ON for live keys regardless of this value. Leave false in local
# development, where there is no routable client IP to bind to.
MOONPAY_REQUIRE_IP_MATCH=false

# Optional widget appearance. themeId is a custom theme built in the MoonPay
# dashboard's theme builder; leave it empty unless you have one.
# MOONPAY_THEME=light
# MOONPAY_THEME_ID=

# Replay window for inbound webhooks, in seconds. Default 3600.
# Deliberately not 300: MoonPay retries up to nine times with exponential
# backoff and does not document whether retries are re-signed, so a five-minute
# window risks rejecting legitimate retries forever. Replay is really prevented
# by the unique constraint on provider_events, not by this. Tighten it once
# MoonPay confirms their retry-signing behaviour in writing.
# MOONPAY_WEBHOOK_TOLERANCE_SECONDS=3600

# TEST ONLY. Points the provider at a stub instead of MoonPay; refused at boot
# whenever the keys are live. Leave unset everywhere that matters.
# MOONPAY_API_BASE_URL=https://api.moonpay.com
# MOONPAY_WIDGET_BASE_URL=https://buy-sandbox.moonpay.com

# Storefront origin. The checkout URL returned with a new order and MoonPay's
# redirectURL are both built from this, so it must be the address the
# customer's browser can actually reach. MoonPay requires redirectURL to be
# HTTPS in live mode - a plain http:// origin works in sandbox only.
WEB_BASE_URL=http://localhost:3001

# --- retention ---
# 5 years. Set from the strictest AML regime you operate under, not the loosest.
AML_RETENTION_DAYS=1825

PORT=3000

# --- API auth ---
# Checked by ApiKeyGuard on all /orders* routes. apps/web sends this as
# X-API-Key from its server-only BFF layer - it must never reach the browser.
PAYMENT_API_KEY=
