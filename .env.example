# --- database ---
# Local Postgres install (not the docker-compose container).
# postgresql://<user>:<password>@<host>:<port>/payment_platform
DATABASE_URL=postgresql://postgres:pavi1234@localhost:5433/payment_platform
DB_POOL_MAX=10
DB_SSL=false

# --- PII key material ---
# Local dev only. In production these MUST come from a KMS / secret manager,
# never from env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_MASTER_KEK=
# Must survive subject erasure, so it is a separate secret from the KEK.
PII_BLIND_INDEX_PEPPER=

# --- Stripe fiat-to-crypto onramp ---
# Access is gated: submit the onramp application at
# https://dashboard.stripe.com/crypto-onramp/get-started before these work,
# in sandbox as well as live. Keys come from https://dashboard.stripe.com/apikeys.
STRIPE_SECRET_KEY=
# Handed to the browser so the widget can load. Publishable by design.
STRIPE_PUBLISHABLE_KEY=
# Endpoint signing secret (whsec_...) for THIS endpoint. Not the API key, and
# different per endpoint and per mode. `stripe listen` prints one for local use.
STRIPE_ONRAMP_WEBHOOK_SECRET=
# 'embedded' mounts Stripe's widget on our own page (default, recommended).
# 'hosted' redirects to crypto.link.com - which takes no return URL, so the
# customer is never sent back to us.
STRIPE_ONRAMP_MODE=embedded
# TEST ONLY. Points the provider at a stub instead of Stripe; refused at boot
# when the secret key is live. Leave unset everywhere that matters.
# STRIPE_API_BASE_URL=https://api.stripe.com

# Storefront origin. The checkout URL returned with a new order is built from
# this, so it must be the address the customer's browser can actually reach.
WEB_BASE_URL=http://localhost:3001

# --- retention ---
# 5 years. Set from the strictest AML regime you operate under, not the loosest.
AML_RETENTION_DAYS=1825

PORT=3000

# --- API auth ---
# Checked by ApiKeyGuard on all /orders* routes. apps/web sends this as
# X-API-Key from its server-only BFF layer - it must never reach the browser.
PAYMENT_API_KEY=
